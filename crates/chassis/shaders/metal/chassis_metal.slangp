# The bank casting as a one-pass preset, for this crate's own render tests.
# The host that ships it writes its own copy of these lines
# (`app::column::PRESET`).
#
# `scale_type0`/`scale0` are inert here and there: a chain's last pass renders
# straight to the viewport, so its framebuffer size is the viewport's and no
# scale is consulted. They are left in because a preset that names a pass and
# says nothing about it reads as an oversight; what the pass is actually drawn
# into is the `Viewport` the host passes to `frame`, and what `OutputSize`
# reports is the size the host declares on the output view -- the screen well,
# not this pass's rectangle (`chassis_metal.slang`'s header).
shaders = 1

shader0 = chassis_metal.slang
scale_type0 = source
scale0 = 1.0
filter_linear0 = false
wrap_mode0 = clamp_to_edge
