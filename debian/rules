#!/usr/bin/make -f

%:
	dh $@

override_dh_auto_build:
	cargo build --release

# The workspace's tests run in CI and on the developer's machine; a
# package build is not the place to run them again.
override_dh_auto_test:

override_dh_auto_install:
	cargo run -p xtask -- stage-deb --root debian/robco-term/usr

# cargo's target directory is shared machine-wide on the build hosts;
# a package build must not empty it.
override_dh_auto_clean:

# dwz does not understand the DWARF rustc emits at this scale; dh_strip
# still strips the binary without it.
override_dh_dwz:

# Debug information is not part of what this project distributes, so the
# build makes none to distribute. dh_strip still strips the binary; what it
# no longer does is package the symbols it took out as a separate .ddeb that
# every build wrote and no release carried.
override_dh_strip:
	dh_strip --no-automatic-dbgsym
