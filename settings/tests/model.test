# The model: resolution (pinned, then the named preset, then the shipped
# default), the four edits of a flat table, and the ssh rows, each held to
# the machine-write contract's bar that one changed key is one changed
# line. A row that is added or removed is one added or removed block, and
# every byte around it stands.

package require tcltest 2.5
namespace import ::tcltest::*

source [file join [file dirname [info script]] helpers.tcl]
source [file join $::libdir model.tcl]
force_test_binary

set ::data [::rcsettings::dump::load_text $::dumptext fixture]
set ::configdir [file join [temporaryDirectory] model-[pid]]
set ::configpath [file join $::configdir config.toml]

# Put $text on disk and point the model at it. Returns the text, so a
# test can compare the file's bytes before and after an edit.
proc with_config {text} {
    file mkdir $::configdir
    ::rcsettings::toml::atomic_write $::configpath $text
    ::rcsettings::model::init $::data $::configpath
    return $text
}

proc without_config {} {
    file delete -force $::configdir
    ::rcsettings::model::init $::data $::configpath
}

proc on_disk {} {
    return [::rcsettings::toml::read_file $::configpath]
}

# Every screen key the dump knows, as the user currently sees it. What
# pin_overrides must leave unchanged.
proc screen_look {} {
    set out {}
    foreach key [::rcsettings::dump::table_keys $::data screen] {
        if {$key eq "name"} { continue }
        lappend out $key [::rcsettings::model::effective screen $key]
    }
    return $out
}

# A robco-term old enough to have no --dump-settings can sit on PATH, so
# the constraint is that the dump works, not that a binary is there.
testConstraint realBinary [expr {![catch {::rcsettings::dump::load} ::realdump]}]

test dump-1.1 {defaults come out as raw TOML, presets in dump order} -body {
    list [::rcsettings::dump::default $::data screen bloom] \
        [::rcsettings::dump::preset_names $::data screen] \
        [::rcsettings::dump::preset_names $::data chassis]
} -result {0.6 {{Default Amber} {Deep Blue} E-Ink} {Annunciator Switchboard}}

test dump-1.2 {fonts are catalogue key and display name} -body {
    lindex [::rcsettings::dump::fonts $::data] 1
} -result {COZETTE_SCALED Cozette}

test dump-1.3 {a multi-line value list becomes a Tcl list} -body {
    list [::rcsettings::dump::enum $::data shell] \
        [::rcsettings::dump::enum $::data channel_display]
} -result {{annunciator slide-rule switchboard} {led tape}}

test dump-1.4 {an unknown table or preset is an error, never a guess} -body {
    list [catch {::rcsettings::dump::preset $::data screen Vintage}] \
        [catch {::rcsettings::dump::default $::data screen no_such_key}]
} -result {1 1}

test dump-1.5 {the error names what was looked for and where} -body {
    # Both places the app looks, and no third one: a message naming a
    # variable the app no longer reads would send the user somewhere that
    # cannot help them.
    set msg [::rcsettings::dump::describe_search]
    # The sibling is named with the platform's suffix (.exe on Windows),
    # and this suite runs there too, inside the shipped exe's selftest.
    set sibling "robco-term[::rcsettings::dump::exe_suffix]"
    expr {[string match "*$sibling beside this interpreter*" $msg]
          && [string match "*robco-term on PATH*" $msg]
          && ![string match "*ROBCO_TERM*" $msg]}
} -result 1

test dump-1.6 {the real binary's dump parses} -constraints realBinary -body {
    set real $::realdump
    list [expr {[llength [::rcsettings::dump::preset_names $real screen]] > 0}] \
        [expr {[llength [::rcsettings::dump::fonts $real]] > 0}] \
        [::rcsettings::toml::type_of [::rcsettings::dump::default $real screen bloom]] \
        [expr {"no_rasterization" in [::rcsettings::dump::enum $real rasterization]}]
} -result {1 1 float 1}

test effective-2.1 {pinned, then the named preset, then the default} -setup {
    with_config $::fixture
} -body {
    list [::rcsettings::model::effective screen bloom] \
        [::rcsettings::model::effective screen font_color] \
        [::rcsettings::model::effective general led_characters]
} -result {0.9 #5c9dff 12}

test effective-2.2 {the base of an unpinned key is the preset's value} -setup {
    with_config $::fixture
} -body {
    list [::rcsettings::model::base screen bloom] \
        [::rcsettings::model::pinned screen bloom] \
        [::rcsettings::model::pinned screen font_color] \
        [::rcsettings::model::preset_name screen]
} -result {0.5 1 0 {Deep Blue}}

test effective-2.3 {a name matching no built-in falls back to the default} -setup {
    with_config "\[screen\]\nname = \"my workshop\"\n"
} -body {
    list [::rcsettings::model::effective screen bloom] \
        [::rcsettings::model::effective screen font_name]
} -result {0.6 TERMINESS_SCALED}

test effective-2.4 {an unnamed table resolves against the shipped default} -setup {
    without_config
} -body {
    list [::rcsettings::model::preset_name screen] \
        [::rcsettings::model::effective screen bloom] \
        [::rcsettings::model::effective chassis shell]
} -result {{Default Amber} 0.6 annunciator}

test set-3.1 {an edit changes one line and no other byte} -setup {
    set before [with_config $::fixture]
} -body {
    ::rcsettings::model::set_value screen bloom 0.4
    list [surgery $before [on_disk]] [::rcsettings::model::effective screen bloom]
} -result {{{{bloom = 0.9}} {{bloom = 0.4}}} 0.4}

test set-3.2 {a value equal to the base is written by removing the key} -setup {
    set before [with_config $::fixture]
} -body {
    ::rcsettings::model::set_value screen bloom 0.5
    list [surgery $before [on_disk]] \
        [::rcsettings::model::pinned screen bloom] \
        [::rcsettings::model::effective screen bloom]
} -result {{{{bloom = 0.9}} {}} 0 0.5}

test set-3.3 {the base is the preset's value, not the shipped default} -setup {
    with_config $::fixture
} -body {
    ::rcsettings::model::set_value screen bloom 0.6
    list [::rcsettings::model::pinned screen bloom] \
        [::rcsettings::toml::get_key [on_disk] screen bloom]
} -result {1 0.6}

test set-3.4 {a key the file does not have yet costs one added line} -setup {
    set before [with_config $::fixture]
} -body {
    ::rcsettings::model::set_value screen font_name IOSEVKA
    surgery $before [on_disk]
} -result {{} {{font_name = "IOSEVKA"}}}

test set-3.5 {a value is formatted after the type of its default} -setup {
    with_config $::fixture
} -body {
    ::rcsettings::model::set_value screen font_name IOSEVKA
    ::rcsettings::model::set_value general led_characters 20
    ::rcsettings::model::set_value screen blinking_cursor 1
    ::rcsettings::model::set_value general font_scaling 2
    set text [on_disk]
    lmap {table key} {screen font_name general led_characters
                      screen blinking_cursor general font_scaling} {
        ::rcsettings::toml::get_key $text $table $key
    }
} -result {{"IOSEVKA"} 20 true 2.0}

test set-3.6 {an absent file is an empty document to edit} -setup {
    without_config
} -body {
    ::rcsettings::model::set_value chassis frame_size 0.6
    on_disk
} -result "\[chassis\]\nframe_size = 0.6\n"

test set-3.7 {the file is re-read before each write} -setup {
    with_config $::fixture
} -body {
    # Another writer lands between the model's load and its next edit.
    ::rcsettings::toml::atomic_write $::configpath \
        [::rcsettings::toml::set_key $::fixture general led_characters 20]
    ::rcsettings::model::set_value screen bloom 0.4
    list [::rcsettings::toml::get_key [on_disk] general led_characters] \
        [::rcsettings::toml::get_key [on_disk] screen bloom]
} -result {20 0.4}

test reset-4.1 {reset unpins, leaving the preset's value showing} -setup {
    set before [with_config $::fixture]
} -body {
    ::rcsettings::model::reset screen bloom
    list [surgery $before [on_disk]] [::rcsettings::model::effective screen bloom]
} -result {{{{bloom = 0.9}} {}} 0.5}

test switch-5.1 {switching presets drops this table's overrides only} -setup {
    with_config $::fixture
} -body {
    ::rcsettings::model::switch_preset screen E-Ink
    list [on_disk] [::rcsettings::model::effective screen bloom]
} -result "{# The workshop terminal.
# Do not let the bloom get away from you again.

\[general\]
font_scaling   =   1.2\t# bigger type, fewer rows
effects_frame_skip = 2


# the look
\[screen\]
name = \"E-Ink\"
mystery_key = \"kept\"

\[dotfiles_tool\]
generated_at = \"2026-08-01\"
} 0.0"

test switch-5.2 {naming the shipped preset removes the name key} -setup {
    with_config $::fixture
} -body {
    ::rcsettings::model::switch_preset screen {Default Amber}
    list [::rcsettings::model::pinned screen name] \
        [::rcsettings::model::preset_name screen] \
        [::rcsettings::model::effective screen bloom] \
        [::rcsettings::toml::get_key [on_disk] screen mystery_key]
} -result {0 {Default Amber} 0.6 {"kept"}}

test switch-5.3 {switching a table the file has no header for} -setup {
    without_config
} -body {
    ::rcsettings::model::switch_preset chassis Switchboard
    list [on_disk] [::rcsettings::model::effective chassis channel_display]
} -result "{\[chassis\]\nname = \"Switchboard\"\n} tape"

test pin-6.1 {pinning overrides keeps every visible value where it was} -setup {
    with_config $::fixture
} -body {
    set was [screen_look]
    ::rcsettings::model::pin_overrides screen E-Ink
    list [::rcsettings::model::preset_name screen] \
        [string equal $was [screen_look]] \
        [::rcsettings::model::pinned screen font_color]
} -result {E-Ink 1 1}

test pin-6.2 {a pinned key the new base already gives is unpinned} -setup {
    with_config "\[screen\]\nname = \"Deep Blue\"\njitter = 0.2\nbloom = 0.9\n"
} -body {
    set was [screen_look]
    ::rcsettings::model::pin_overrides screen {Default Amber}
    list [string equal $was [screen_look]] \
        [::rcsettings::model::pinned screen jitter] \
        [::rcsettings::model::pinned screen bloom] \
        [::rcsettings::model::pinned screen name]
} -result {1 0 1 0}

test pin-6.3 {pinning against a name no preset answers to} -setup {
    with_config $::fixture
} -body {
    set was [screen_look]
    ::rcsettings::model::pin_overrides screen {my workshop}
    list [::rcsettings::model::preset_name screen] [string equal $was [screen_look]]
} -result {{my workshop} 1}

# The rows as the tab draws them: the host of each, and which one the
# file's `default` puts the check on.
proc ssh_view {} {
    set out {}
    foreach row [::rcsettings::model::ssh_hosts] { lappend out [dict get $row host] }
    return [list $out [::rcsettings::model::ssh_default]]
}

test ssh-8.1 {rows resolve their fields against the row defaults} -setup {
    with_config $::sshfixture
} -body {
    list [ssh_view] [lindex [::rcsettings::model::ssh_hosts] 1]
} -result {{{vault relay spare} vault} {host relay user {} port 2222 key {}}}

test ssh-8.2 {a file with no rows has none, and starts on localhost} -setup {
    with_config $::fixture
} -body {
    ssh_view
} -result {{} {}}

test ssh-8.3 {a default naming no row is what it is; the tab reads it} -setup {
    with_config "\[ssh\]\ndefault = \"gone\"\n"
} -body {
    ssh_view
} -result {{} gone}

test ssh-9.1 {a field equal to the row default is written by removing it} -setup {
    set before [with_config $::sshfixture]
} -body {
    ::rcsettings::model::set_ssh_host 1 port 22
    list [surgery $before [on_disk]] \
        [dict get [lindex [::rcsettings::model::ssh_hosts] 1] port]
} -result {{{{port = 2222}} {}} 22}

test ssh-9.2 {a field away from its default is one changed line} -setup {
    set before [with_config $::sshfixture]
} -body {
    ::rcsettings::model::set_ssh_host 2 port 2022
    list [surgery $before [on_disk]] \
        [lmap row [::rcsettings::model::ssh_hosts] {dict get $row port}]
} -result {{{} {{port = 2022}}} {22 2222 2022}}

test ssh-9.3 {host is written even when it is the row default's own value} -setup {
    with_config $::sshfixture
} -body {
    ::rcsettings::model::set_ssh_host 2 host ""
    list [::rcsettings::toml::array_spans [on_disk] ssh.host] \
        [lmap row [::rcsettings::model::ssh_hosts] {dict get $row host}]
} -result {{{7 12} {12 16} {16 19}} {vault relay {}}}

test ssh-9.4 {a field is formatted after the type of its row default} -setup {
    with_config $::sshfixture
} -body {
    ::rcsettings::model::set_ssh_host 0 port 2222
    ::rcsettings::model::set_ssh_host 0 key {~/.ssh/id_ed25519}
    set entry [lindex [dict get [::rcsettings::toml::parse [on_disk]] \
        arrays ssh.host] 0]
    list [dict get $entry port] [dict get $entry key]
} -result {2222 {"~/.ssh/id_ed25519"}}

test ssh-9.5 {an unknown key inside a row is round-tripped} -setup {
    with_config $::sshfixture
} -body {
    ::rcsettings::model::set_ssh_host 0 user "someone"
    ::rcsettings::toml::plain [dict get [lindex [dict get \
        [::rcsettings::toml::parse [on_disk]] arrays ssh.host] 0] note]
} -result {unknown to this tool}

test ssh-10.1 {renaming the checked row takes the check with it} -setup {
    set before [with_config $::sshfixture]
} -body {
    ::rcsettings::model::set_ssh_host 0 host "vault.example.com"
    list [surgery $before [on_disk]] [ssh_view]
} -result {{{{default = "vault"} {odd_key = "kept"} {} {# the vault, behind the door} {[[ssh.host]]} {host = "vault"}} {{default = "vault.example.com"} {odd_key = "kept"} {} {# the vault, behind the door} {[[ssh.host]]} {host = "vault.example.com"}}} {{vault.example.com relay spare} vault.example.com}}

test ssh-10.2 {renaming a row the check is not on leaves the check} -setup {
    with_config $::sshfixture
} -body {
    ::rcsettings::model::set_ssh_host 1 host "relay.example.com"
    ssh_view
} -result {{vault relay.example.com spare} vault}

test ssh-11.1 {checking a row writes its host as the default} -setup {
    set before [with_config $::sshfixture]
} -body {
    ::rcsettings::model::set_ssh_default "spare"
    list [surgery $before [on_disk]] [::rcsettings::model::ssh_default]
} -result {{{{default = "vault"}} {{default = "spare"}}} spare}

test ssh-11.2 {checking localhost removes the key rather than emptying it} -setup {
    set before [with_config $::sshfixture]
} -body {
    ::rcsettings::model::set_ssh_default ""
    list [surgery $before [on_disk]] \
        [dict exists [::rcsettings::toml::parse [on_disk]] tables ssh default] \
        [::rcsettings::model::ssh_default]
} -result {{{{default = "vault"}} {}} 0 {}}

test ssh-11.3 {a default for rows that have no table above them} -setup {
    with_config "\[\[ssh.host\]\]\nhost = \"a\"\n"
} -body {
    # An explicit `[ssh]` after its own rows is not a document the
    # terminal's parser reads back, so the table goes above them.
    ::rcsettings::model::set_ssh_default "a"
    on_disk
} -result "\[ssh\]\ndefault = \"a\"\n\n\[\[ssh.host\]\]\nhost = \"a\"\n"

test ssh-12.1 {a new row carries its host and nothing else} -setup {
    set before [with_config $::sshfixture]
} -body {
    ::rcsettings::model::add_ssh_host
    list [surgery $before [on_disk]] [lindex [::rcsettings::model::ssh_hosts] 3]
} -result {{{} {{[[ssh.host]]} {host = ""} {}}} {host {} user {} port 22 key {}}}

test ssh-12.2 {the first row of a file that has none} -setup {
    without_config
} -body {
    ::rcsettings::model::add_ssh_host
    ::rcsettings::model::set_ssh_host 0 host "vault"
    ::rcsettings::model::set_ssh_default "vault"
    on_disk
} -result "\[ssh\]\ndefault = \"vault\"\n\n\[\[ssh.host\]\]\nhost = \"vault\"\n"

test ssh-13.1 {removing a row leaves every other row's bytes} -setup {
    set before [with_config $::sshfixture]
} -body {
    ::rcsettings::model::remove_ssh_host 1
    list [surgery $before [on_disk]] [ssh_view]
} -result {{{{host = "relay"} {port = 2222} {} {[[ssh.host]]}} {}} {{vault spare} vault}}

test ssh-13.2 {removing the checked row unchecks it} -setup {
    with_config $::sshfixture
} -body {
    ::rcsettings::model::remove_ssh_host 0
    list [ssh_view] \
        [dict exists [::rcsettings::toml::parse [on_disk]] tables ssh default]
} -result {{{relay spare} {}} 0}

test ssh-13.3 {a row of the same name still answering keeps the check} -setup {
    with_config "\[ssh\]\ndefault = \"a\"\n\n\[\[ssh.host\]\]\nhost = \"a\"\n\n\[\[ssh.host\]\]\nhost = \"a\"\nport = 2222\n"
} -body {
    ::rcsettings::model::remove_ssh_host 0
    ssh_view
} -result {a a}

test ssh-14.1 {the file is re-read before an ssh write too} -setup {
    with_config $::sshfixture
} -body {
    ::rcsettings::toml::atomic_write $::configpath \
        [::rcsettings::toml::set_key $::sshfixture general led_characters 20]
    ::rcsettings::model::set_ssh_host 1 port 2200
    list [::rcsettings::toml::get_key [on_disk] general led_characters] \
        [lindex [::rcsettings::model::ssh_hosts] 1]
} -result {20 {host relay user {} port 2200 key {}}}

test guard-15.1 {an edit is refused whole on a file outside the subset} -setup {
    with_config "\[general\]\nbanner = \"\"\"\nwelcome\n\[screen\]\n\"\"\"\n"
} -body {
    set code [catch {::rcsettings::model::set_value screen bloom 0.4} err]
    # The refusal must leave the file's bytes exactly as they were: the
    # guard exists so nothing lands inside the string's body.
    list $code [string match "*cannot edit safely*" $err] \
        [string equal [on_disk] \
            "\[general\]\nbanner = \"\"\"\nwelcome\n\[screen\]\n\"\"\"\n"]
} -result {1 1 1}

test guard-15.2 {reading an unsafe file still works} -setup {
    with_config "\[general\]\nfont_scaling = 1.5\npoint = { x = 1 }\n"
} -body {
    ::rcsettings::model::effective general font_scaling
} -result 1.5

test path-7.1 {the platform's default config path} -body {
    set saved [array get ::env XDG_CONFIG_HOME]
    set ::env(XDG_CONFIG_HOME) [file join / xdg]
    set p [::rcsettings::model::default_config_path]
    unset ::env(XDG_CONFIG_HOME)
    array set ::env $saved
    expr {$::tcl_platform(platform) eq "unix" && $::tcl_platform(os) ne "Darwin"
          ? $p eq [file join / xdg robco-term config.toml]
          : 1}
} -result 1

file delete -force $::configdir
::tcltest::cleanupTests
