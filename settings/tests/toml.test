# The line-surgery reader/writer against the machine-write contract
# (docs/config-format.md). The bar these tests hold it to is the
# contract's own: an edit to one key changes only that key's bytes.

package require tcltest 2.5
namespace import ::tcltest::*

source [file join [file dirname [info script]] helpers.tcl]
source [file join $::libdir toml.tcl]

namespace eval tt {
    namespace path ::rcsettings::toml
}

test parse-1.1 {tables, keys and raw values} -body {
    set p [::rcsettings::toml::parse $::fixture]
    list [dict get $p tables general effects_frame_skip] \
        [dict get $p tables screen name] \
        [dict get $p tables screen bloom] \
        [dict get $p tables dotfiles_tool generated_at]
} -result {2 {"Deep Blue"} 0.9 {"2026-08-01"}}

test parse-1.2 {a trailing same-line comment is not part of the value} -body {
    dict get [::rcsettings::toml::parse $::fixture] tables general font_scaling
} -result 1.2

test parse-1.3 {arrays of tables collect in declaration order} -body {
    set p [::rcsettings::toml::parse $::dumptext]
    set names {}
    foreach entry [dict get $p arrays screen_presets] {
        lappend names [dict get $entry name]
    }
    set names
} -result {{"Default Amber"} {"Deep Blue"} {"E-Ink"}}

test parse-1.4 {a multi-line array value is one value} -body {
    dict get [::rcsettings::toml::parse $::dumptext] tables values channel_display
} -result {[ "led", "tape", ]}

test parse-1.5 {a # inside a quoted string is not a comment} -body {
    dict get [::rcsettings::toml::parse "\[screen\]\nfont_color = \"#ff8100\" # amber\n"] \
        tables screen font_color
} -result {"#ff8100"}

test set-2.1 {setting an existing key touches that line only} -body {
    surgery $::fixture [::rcsettings::toml::set_key $::fixture screen bloom 0.4]
} -result {{{bloom = 0.9}} {{bloom = 0.4}}}

test set-2.2 {a key's spacing and trailing comment survive a new value} -body {
    surgery $::fixture \
        [::rcsettings::toml::set_key $::fixture general font_scaling 1.5]
} -result "{{font_scaling   =   1.2\t# bigger type, fewer rows}} {{font_scaling   =   1.5\t# bigger type, fewer rows}}"

test set-2.3 {a new key is added to its table, nothing else moves} -body {
    surgery $::fixture \
        [::rcsettings::toml::set_key $::fixture screen jitter 0.0]
} -result {{} {{jitter = 0.0}}}

test set-2.4 {a new key lands inside its table, above the blank padding} -body {
    set out [::rcsettings::toml::set_key $::fixture general window_scaling 1.25]
    dict get [::rcsettings::toml::parse $out] tables general window_scaling
} -result 1.25

test set-2.5 {a new key does not come between a comment and its table} -body {
    set out [::rcsettings::toml::set_key $::fixture general window_scaling 1.25]
    set lines [split $out "\n"]
    lrange $lines [expr {[lsearch -exact $lines {window_scaling = 1.25}] + 1}] end-1
} -result {{} {} {# the look} {[screen]} {name = "Deep Blue"} {bloom = 0.9} {mystery_key = "kept"} {} {[dotfiles_tool]} {generated_at = "2026-08-01"}}

test set-2.6 {an absent table is appended, the document above it untouched} -body {
    set out [::rcsettings::toml::set_key $::fixture chassis shell {"switchboard"}]
    list [string equal $::fixture [string range $out 0 [expr {[string length $::fixture] - 1}]]] \
        [string range $out [string length $::fixture] end]
} -result "1 {\n\[chassis\]\nshell = \"switchboard\"\n}"

test set-2.7 {a missing file is an empty document, not an error} -body {
    ::rcsettings::toml::set_key [::rcsettings::toml::read_file \
        [file join [temporaryDirectory] no-such-dir config.toml]] screen name {"E-Ink"}
} -result "\[screen\]\nname = \"E-Ink\"\n"

test unset-3.1 {unsetting removes one line and nothing else} -body {
    surgery $::fixture [::rcsettings::toml::unset_key $::fixture screen bloom]
} -result {{{bloom = 0.9}} {}}

test unset-3.2 {unsetting the last key of a table keeps the header} -body {
    set out [::rcsettings::toml::unset_key $::fixture dotfiles_tool generated_at]
    list [surgery $::fixture $out] \
        [dict exists [::rcsettings::toml::parse $out] tables dotfiles_tool]
} -result {{{{generated_at = "2026-08-01"}} {}} 1}

test unset-3.3 {unsetting an absent key is a no-op, byte for byte} -body {
    list [string equal $::fixture [::rcsettings::toml::unset_key $::fixture screen margin]] \
        [string equal $::fixture [::rcsettings::toml::unset_key $::fixture nosuch key]]
} -result {1 1}

test unset-3.4 {a key of another table with the same name is not touched} -body {
    set text "\[a\]\nk = 1\n\n\[b\]\nk = 2\n"
    ::rcsettings::toml::unset_key $text b k
} -result "\[a\]\nk = 1\n\n\[b\]\n"

test type-4.1 {scalar types come from the raw spelling} -body {
    lmap raw {{"x"} true false 12 -3 1.0 0.45 1.0e3 no_rasterization} {
        ::rcsettings::toml::type_of $raw
    }
} -result {string bool bool int int float float float string}

test format-5.1 {a float always carries a decimal point} -body {
    lmap v {1 0.45 0.0} {::rcsettings::toml::format_value float $v}
} -result {1.0 0.45 0.0}

test format-5.2 {quotes and backslashes are escaped on the way out} -body {
    ::rcsettings::toml::format_value string {a "b" c\d}
} -result {"a \"b\" c\\d"}

test format-5.3 {a formatted string reads back as what went in} -body {
    ::rcsettings::toml::plain [::rcsettings::toml::format_value string {a "b" c\d}]
} -result {a "b" c\d}

test format-5.4 {an escaped string in a file parses to its plain value} -body {
    set text "\[screen\]\nfont_name = \"a \\\"b\\\" c\"\n"
    ::rcsettings::toml::plain \
        [::rcsettings::toml::get_key $text screen font_name]
} -result {a "b" c}

test io-6.1 {a missing file reads as the empty document} -body {
    ::rcsettings::toml::read_file [file join [temporaryDirectory] absent config.toml]
} -result {}

test io-6.2 {atomic_write then read_file round-trips the bytes} -setup {
    set path [file join [temporaryDirectory] rt config.toml]
} -body {
    set text "$::fixture# a lone comment, no trailing newline\n# and a é in it"
    ::rcsettings::toml::atomic_write $path $text
    string equal $text [::rcsettings::toml::read_file $path]
} -cleanup {
    file delete -force [file dirname $path]
} -result 1

test io-6.3 {the write lands by rename in the config file's own directory} -setup {
    set path [file join [temporaryDirectory] rt2 config.toml]
} -body {
    ::rcsettings::toml::atomic_write $path "\[screen\]\n"
    glob -nocomplain -tails -types f -directory [file dirname $path] * .*
} -cleanup {
    file delete -force [file dirname $path]
} -result {config.toml}

cleanupTests
